            <column caption='Discount Band' datatype='string' name='[Calculation_0299118430461960]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [discount] = 0 THEN &apos;0%&apos;&#13;&#10;ELSEIF [discount] &lt;= 0.2 THEN &apos;1–20%&apos;&#13;&#10;ELSEIF [discount] &lt;= 0.4 THEN &apos;21–40%&apos;&#13;&#10;ELSE &apos;40%+&apos; END' />
