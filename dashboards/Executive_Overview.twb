      <aliases enabled='yes' />
      <column caption='Total Sales' datatype='real' name='[Calculation_0299118397345792]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sales])' />
      </column>
      <column caption='Total Profit' datatype='real' name='[Calculation_0299118397489153]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([profit])' />
      </column>
      <column caption='Profit Margin %' datatype='real' name='[Calculation_0299118397710338]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([profit]) / SUM([sales])*100' />
      </column>
      <column caption='Orders' datatype='integer' name='[Calculation_0299118398009347]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([order_id])' />
      </column>
      <column caption='Avg Order Value' datatype='real' name='[Calculation_0299118398279684]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sales]) / COUNTD([order_id])' />
      </column>
      <column caption='Avg Discount' datatype='real' name='[Calculation_0299118398386181]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([discount])' />
      </column>
      <column caption='Loss Lines %' datatype='real' name='[Calculation_0299118398464006]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [profit] &lt; 0 THEN 1 ELSE 0 END) / COUNT([order_id])*100' />
      </column>
      <column caption='Is_Weekend' datatype='string' name='[Calculation_0299118417899527]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_weekend] THEN &apos;Weekend&apos;&#13;&#10;ELSE &apos;Weekday&apos; END' />
      </column>
      <column caption='Discount Band' datatype='string' name='[Calculation_0299118430461960]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [discount] = 0 THEN &apos;0%&apos;&#13;&#10;ELSEIF [discount] &lt;= 0.2 THEN &apos;1–20%&apos;&#13;&#10;ELSEIF [discount] &lt;= 0.4 THEN &apos;21–40%&apos;&#13;&#10;ELSE &apos;40%+&apos; END' />
      </column>
      <column caption='Total Loss' datatype='real' name='[Calculation_0299118430715913]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [profit] &lt; 0 THEN [profit] END)' />
      </column>
      <column caption='Below SubCat Avg' datatype='string' name='[Calculation_0299118430949386]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [profit] &lt; {FIXED [sub_category] : AVG([profit])}&#13;&#10;THEN &apos;Below Avg&apos; ELSE &apos;At/Above Avg&apos; END' />
      </column>
      <column caption='Profit Health' datatype='string' name='[Calculation_0299118433296395]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [profit] &lt; 0 THEN &apos;Loss&apos;&#13;&#10;ELSEIF [profit] &lt; [sales] * 0.10 THEN &apos;Thin Margin&apos;&#13;&#10;ELSE &apos;Healthy&apos; END' />
      </column>
      <column caption='Top_Products' datatype='integer' name='[Calculation_0299118437560332]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([profit]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Customer Profit' datatype='real' name='[Calculation_0299118446313485]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [customer_id] : SUM([profit])}' />
      </column>
      <column caption='Customer Tier' datatype='string' name='[Calculation_0299118446747662]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0299118446313485] &gt;= 500 THEN &apos;High Value&apos;&#13;&#10;ELSEIF [Calculation_0299118446313485] &gt;= 0 THEN &apos;Standard&apos;&#13;&#10;ELSE &apos;At Risk (Net Loss)&apos; END' />
      </column>
      <column caption='Recency (days)' datatype='integer' name='[Calculation_0299118446964751]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, {FIXED [customer_id] : MAX([full_date])}, {MAX([full_date])})' />
      </column>
      <column caption='Vs Own Average' datatype='string' name='[Calculation_0299118447493136]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [profit] &gt; {FIXED [customer_id] : AVG([profit])}&#13;&#10;THEN &apos;Above Own Average&apos; ELSE &apos;At or Below Own Average&apos; END' />
      </column>
      <column caption='Avg Profit per Customer' datatype='real' name='[Calculation_0299118447652881]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([profit]) / COUNTD([customer_id])' />
      </column>
      <column caption='At Risk %' datatype='real' name='[Calculation_0299118447812626]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Calculation_0299118446747662] = &apos;At Risk (Net Loss)&apos; THEN [customer_id] END)&#13;&#10;/ COUNTD([customer_id]) *100' />
      </column>
      <column caption='Recency FIXED' datatype='integer' name='[Calculation_0913195949940738]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, {FIXED [customer_id] : MAX([full_date])}, {MAX([full_date])})' />
      </column>
      <column caption='Frequency FIXED' datatype='integer' name='[Calculation_0913195950034947]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [customer_id] : COUNTD([order_id])}' />
      </column>
      <column caption='RFM Segment' datatype='string' name='[Calculation_0913195950309381]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0913195949940738] &lt;= 90 AND [Calculation_0913195950034947] &gt;= 4 THEN &apos;Champions&apos;&#13;&#10;ELSEIF [Calculation_0913195949940738] &lt;= 90 THEN &apos;Recent&apos;&#13;&#10;ELSEIF [Calculation_0913195950034947] &gt;= 4 THEN &apos;loyal but inactive&apos;&#13;&#10;ELSEIF [Calculation_0913195949940738] &lt;= 365 THEN &apos;Cooling Down&apos;&#13;&#10;ELSE &apos;Lost&apos; END' />
      </column>
      <column caption='Shipping Duration Days (bin)' datatype='integer' name='[Shipping Duration Days (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='0' formula='[shipping_duration_days]' peg='0' size='1' />
      </column>
