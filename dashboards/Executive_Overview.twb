            <column-instance column='[Calculation_0299118397710338]' derivation='User' name='[usr:Calculation_0299118397710338:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <manual-sort column='[federated.10387ro0izt5ks16vwlgk15n9znr].[none:Calculation_0299118430461960:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;0\%&quot;</bucket>
              <bucket>&quot;1–20\%&quot;</bucket>
